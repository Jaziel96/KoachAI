NEXT_PUBLIC_SITE_URL=https://koach.mx

# Número de WhatsApp de Koach, solo dígitos con lada de país (México móvil: 521 + 10 dígitos).
# Para pruebas locales copia este archivo a .env.local y pon tu número; .env.local no se commitea.
# En producción se define en Vercel.
NEXT_PUBLIC_WHATSAPP_NUMBER=5215500000000

# Lista de espera (US-013). SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
# La service key salta RLS; no la compartas ni la pegues en el chat.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
