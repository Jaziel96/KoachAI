# Copiar a .env y completar con valores reales. Nunca commitear .env.

# --- App ---
APP_NAME=Koach
ENVIRONMENT=dev
DEBUG=true

# --- Database (Supabase / Postgres) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/koach
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Redis (docker-compose up -d levanta uno local) ---
REDIS_URL=redis://localhost:6379/0

# --- IA ---
# AI_STRATEGY: api | hybrid | local (ver ADR-002/ADR-007 en docs/plan-desarrollo-sdd.md)
# Por ahora Koach usa solo Claude: Haiku como tier FAST (en vez de Gemini),
# Sonnet para SMART y VISION. GEMINI_API_KEY se deja documentada por si se
# reactiva un segundo proveedor (ver rama archivada feature/US-008-gemini-provider).
AI_STRATEGY=api
AI_SMART_PROVIDER=anthropic
AI_FAST_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# Modelos de Anthropic por tier (sobrescribibles; ver US-007)
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_SMART=claude-sonnet-5
ANTHROPIC_MODEL_VISION=claude-sonnet-5
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_RETRY_AFTER_CAP_SECONDS=30
# VERIFICAR contra la página oficial de precios antes de usar. Sin valores por
# defecto en el código: si el modelo no está aquí, cost_usd queda en None.
# Formato (USD por millón de tokens):
# Incluir una entrada por modelo en uso (FAST, SMART y VISION), p. ej. claude-haiku-4-5 y claude-sonnet-5:
# ANTHROPIC_PRICING={"claude-haiku-4-5": {"input_per_mtok": VERIFICAR, "output_per_mtok": VERIFICAR}, "claude-sonnet-5": {"input_per_mtok": VERIFICAR, "output_per_mtok": VERIFICAR}}

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
# Versión de la Graph API (confirmar la vigente en la documentación de Meta)
WHATSAPP_API_VERSION=

# --- HTTP ---
# Lista separada por comas de orígenes permitidos para CORS
CORS_ALLOWED_ORIGINS=["https://app.koach.mx"]

# --- Observabilidad (Sentry, US-005) ---
# Opcional: si se omite, Sentry no se inicializa (útil en dev local).
SENTRY_DSN=
